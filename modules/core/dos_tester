#input parsers
def ip_parser(ip_add):
    ipl = []
    if "-" in ip_add:
        str_ip, end_ip = map(str, ip_add.split("-"))
        if "." not in end_ip:
            pfix = ".".join(str_ip.split(".")[:-1])
            end_ip = f"{pfix}.{end_ip}"
        end_ip = ipaddress.IPv4Address(end_ip)
        str_ip = ipaddress.IPv4Address(str_ip)
        tmp = str_ip
        while tmp <= end_ip:
            ipl.append(tmp)
            tmp += 1
    elif "/" in ip_add:
        ipt = ipaddress.ip_network(ip_add, strict=False)
        for ips in ipt.hosts():
            ipl.append(ips)
    else:
        ipl.append(ipaddress.IPv4Address(ip_add))

    return ipl

def url_chk(url):
    if url.startswith(("https://", "http://")):
        return url
    try:
        requests.get("https://" + url)
        return "https://" + url
    except requests.exceptions.RequestException:
        return "http://" + url

