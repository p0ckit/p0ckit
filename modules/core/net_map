#!/usr/bin/env python3
#t first

import threading
import ipaddress
import argparse
import subprocess
from concurrent.futures import ThreadPoolExecutor as TPL

parser = argparse.ArgumentParser(description="p0ckit network mapper")

parser.add_argument("--ip", nargs="?", required=True, help="specify the ip subnet/range to map")
parser.add_argument("-wr", "--workers", nargs="?", type=int, default=20, const=50, help="specify the amount of workers to use")
parser.add_argument("-o", "--output", nargs="?", const="mapscan.txt", help="specify the output file")
args = parser.parse_args()

print_lock = threading.Lock()
stop_event = threading.Event()

ip = args.ip
wr = args.workers
opf = args.output

inactive = []
active = []

def ip_parser(ip_add):
    ipl = []
    if "-" in ip_add:
        str_ip, end_ip = map(str, ip_add.split("-"))
        if "." not in end_ip:
            pfix = ".".join(str_ip.split(".")[:-1])
            end_ip = f"{pfix}.{end_ip}"
        end_ip = ipaddress.IPv4Address(end_ip)
        str_ip = ipaddress.IPv4Address(str_ip)
        tmp = str_ip
        while tmp <= end_ip:
            ipl.append(tmp)
            tmp += 1
    elif "/" in ip_add:
        ipt = ipaddress.ip_network(ip_add, strict=False)
        for ips in ipt.hosts():
            ipl.append(ips)
    else:
        ipl.append(ipaddress.IPv4Address(ip_add))

    return ipl

def mapper(ipm):
    if stop_event.is_set():
        return

    cmd = ["ping", "-c", "1", "-W", "1", str(ipm)]

    res = subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    if res.returncode > 2:
        with print_lock:
            if not stop_event.is_set():
                print("[!] Something went wrong with the mapping.")
                print("[!] Please make sure the cmd is right for your OS.")
                stop_event.set()
    elif res.returncode == 1:
        inactive.append(ipm)
    else:
        if args.output:
            active.append(str(ipm))
        print(f"[+] Found active machine at {ipm}")

try:
    with TPL(max_workers=wr) as execut:
        ips = ip_parser(ip)
        for ip in ips:
            execut.submit(mapper, ip)
    print(f"Machines inactive: {len(inactive)} ")
    if args.output:
        with open(opf, "w") as f:
            f.writelines(f"{ipm}\n" for ipm in active)
        print(f"Saved output to {opf}!")
except KeyboardInterrupt:
    stop_event.set()
    print("Quitting...")
    quit()
